--==================================================

local ESPObjects = {}

local function RemoveESP(Player)

    if ESPObjects[Player] then

        for _, Object in ipairs(
            ESPObjects[Player]
        ) do

            if Object
                and Object.Parent then

                Object:Destroy()

            end
        end

        ESPObjects[Player] = nil
    end
end

local function CreateHealthESP(
    Player,
    CharacterModel
)

    RemoveESP(Player)

    if not HealthESPEnabled then
        return
    end

    local Head =
        CharacterModel:FindFirstChild(
            "Head"
        )

    local Hum =
        CharacterModel:FindFirstChildOfClass(
            "Humanoid"
        )

    if not Head or not Hum then
        return
    end

    local Objects = {}

    local Billboard =
        Instance.new("BillboardGui")

    Billboard.Name =
        "PICKA_Health"

    Billboard.Adornee =
        Head

    Billboard.Size =
        UDim2.fromOffset(120, 25)

    Billboard.StudsOffset =
        Vector3.new(0, 3, 0)

    Billboard.AlwaysOnTop =
        true

    Billboard.Parent =
        Head

    local Label =
        Instance.new("TextLabel")

    Label.Size =
        UDim2.fromScale(1, 1)

    Label.BackgroundTransparency =
        1

    Label.Font =
        Enum.Font.GothamBold

    Label.TextSize =
        11

    Label.TextStrokeTransparency =
        0.5

    Label.Parent =
        Billboard

    local Highlight =
        Instance.new("Highlight")

    Highlight.Name =
        "PICKA_HealthHighlight"

    Highlight.DepthMode =
        Enum.HighlightDepthMode.AlwaysOnTop

    Highlight.FillTransparency =
        0.65

    Highlight.OutlineTransparency =
        0

    Highlight.Parent =
        CharacterModel

    table.insert(
        Objects,
        Billboard
    )

    table.insert(
        Objects,
        Highlight
    )

    ESPObjects[Player] =
        Objects

    local Connection

    Connection =
        RunService.RenderStepped:Connect(
            function()

                if not HealthESPEnabled
                    or not CharacterModel.Parent
                    or not Hum.Parent then

                    if Connection then
                        Connection:Disconnect()
                    end

                    return
                end

                local MaxHealth =
                    math.max(
                        Hum.MaxHealth,
                        1
                    )

                local Health =
                    math.max(
                        Hum.Health,
                        0
                    )

                local Percent =
                    Health / MaxHealth

                Label.Text =
                    "HP: "
                    .. math.floor(Health)
                    .. " / "
                    .. math.floor(MaxHealth)

                local CurrentColor

                if Percent > 0.6 then

                    CurrentColor =
                        Color3.fromRGB(
                            80,
                            255,
                            100
                        )

                elseif Percent > 0.3 then

                    CurrentColor =
                        Color3.fromRGB(
                            255,
                            220,
                            70
                        )

                else

                    CurrentColor =
                        Color3.fromRGB(
                            255,
                            70,
                            70
                        )

                end

                Label.TextColor3 =
                    CurrentColor

                Highlight.FillColor =
                    CurrentColor

                Highlight.OutlineColor =
                    CurrentColor

            end
        )

    table.insert(
        Objects,
        Connection
    )
end

local function SetupESPPlayer(Player)

    if Player == LocalPlayer then
        return
    end

    Player.CharacterAdded:Connect(
        function(Char)

            task.wait(0.5)

            if HealthESPEnabled then

                CreateHealthESP(
                    Player,
                    Char
                )

            end

        end
    )

    if Player.Character
        and HealthESPEnabled then

        CreateHealthESP(
            Player,
            Player.Character
        )

    end
end

