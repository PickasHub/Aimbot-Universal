local function KeepWindowInsideScreen()

    local Viewport =
        GetViewport()

    local Width, Height =
        ClampWindowSize(
            Main.AbsoluteSize.X,
            Main.AbsoluteSize.Y
        )

    Main.Size =
        UDim2.fromOffset(
            Width,
            Height
        )

    local HalfW =
        Width / 2

    local HalfH =
        Height / 2

    local CurrentX =
        Main.AbsolutePosition.X
        + HalfW

    local CurrentY =
        Main.AbsolutePosition.Y
        + HalfH

    local MinX =
        HalfW + 5

    local MaxX =
        Viewport.X
        - HalfW
        - 5

    local MinY =
        HalfH + 5

    local MaxY =
        Viewport.Y
        - HalfH
        - 5

    if MaxX < MinX then
        MaxX = MinX
    end

    if MaxY < MinY then
        MaxY = MinY
    end

    local X =
        math.clamp(
            CurrentX,
            MinX,
            MaxX
        )

    local Y =
        math.clamp(
            CurrentY,
            MinY,
            MaxY
        )

    Main.Position =
        UDim2.fromOffset(
            X,
            Y
        )
end

local Camera =
    workspace.CurrentCamera

if Camera then

    Camera:GetPropertyChangedSignal(
        "ViewportSize"
    ):Connect(
        function()
            KeepWindowInsideScreen()
        end
