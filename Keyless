local Resizing = false
local ResizeStart
local ResizeStartSize
local ResizeStartPosition

local function GetViewport()
    local Camera = workspace.CurrentCamera

    if Camera then
        return Camera.ViewportSize
    end

    return Vector2.new(800, 600)
end

local function ClampWindowSize(width, height)
    local Viewport = GetViewport()

    local MinWidth = 300
    local MinHeight = 300

    local MaxWidth = math.max(
        MinWidth,
        math.min(520, Viewport.X - 20)
    )

    local MaxHeight = math.max(
        MinHeight,
        math.min(620, Viewport.Y - 20)
    )

    return
        math.clamp(width, MinWidth, MaxWidth),
        math.clamp(height, MinHeight, MaxHeight)
end

ResizeHandle.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        Resizing = true
        ResizeStart = input.Position
        ResizeStartSize = Main.AbsoluteSize
        ResizeStartPosition = Main.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                Resizing = false
            end
        end)
    end
end)

UIS.InputChanged:Connect(function(input)
    if not Resizing then
        return
    end

    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then

        local Delta = input.Position - ResizeStart

        local NewWidth = ResizeStartSize.X + Delta.X
        local NewHeight = ResizeStartSize.Y + Delta.Y

        NewWidth, NewHeight = ClampWindowSize(
            NewWidth,
            NewHeight
        )

        local WidthDifference =
            NewWidth - ResizeStartSize.X

        local HeightDifference =
            NewHeight - ResizeStartSize.Y

        Main.Size = UDim2.fromOffset(
            NewWidth,
            NewHeight
        )

        Main.Position = UDim2.new(
            ResizeStartPosition.X.Scale,
            ResizeStartPosition.X.Offset + WidthDifference / 2,
            ResizeStartPosition.Y.Scale,
            ResizeStartPosition.Y.Offset + HeightDifference / 2
        )
    end
end)

