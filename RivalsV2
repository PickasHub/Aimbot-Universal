local function clearSnaplines()
    if not SnaplineGui then
        return
    end

    for _, object in ipairs(SnaplineGui:GetChildren()) do
        object:Destroy()
    end
end

local function updateSnaplines()
    clearSnaplines()

    if not State.TargetSnapline then
        return
    end

    local center = Vector2.new(
        Camera.ViewportSize.X / 2,
        Camera.ViewportSize.Y / 2
    )

    for _, player in ipairs(Players:GetPlayers()) do
        if isEnemy(player) then
            local part = getTargetPart(player.Character)

            if part then
                local position, visible =
                    Camera:WorldToViewportPoint(
                        part.Position
                    )

                if visible and position.Z > 0 then
                    local target =
                        Vector2.new(
                            position.X,
                            position.Y
                        )

                    local difference =
                        target - center

                    local length =
                        difference.Magnitude

                    local line =
                        Instance.new("Frame")

                    line.Name =
                        player.Name

                    line.AnchorPoint =
                        Vector2.new(0.5, 0.5)

                    line.BackgroundColor3 =
                        Color3.fromRGB(157, 0, 255)

                    line.BorderSizePixel = 0

                    line.Size =
                        UDim2.fromOffset(
                            length,
                            1
                        )

                    line.Position =
                        UDim2.fromOffset(
                            (center.X + target.X) / 2,
                            (center.Y + target.Y) / 2
                        )

                    line.Rotation =
                        math.deg(
                            math.atan2(
                                difference.Y,
                                difference.X
                            )
                        )

                    line.Parent = SnaplineGui
                end
            end
        end
    end
end

